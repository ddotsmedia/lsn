# ---------------------------------------------------------------------------
# Little Smarties - environment template
# Copy to .env (dev) or /etc/littlesmarties/.env.prod (VPS) and fill in.
# Never commit the filled-in file.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
DB_USER=lsn
DB_PASSWORD=password
DB_NAME=littlesmarties
DB_HOST=postgres
DB_PORT=5432
DATABASE_URL=postgresql://lsn:password@postgres:5432/littlesmarties

# --- Backend --------------------------------------------------------------
PORT=3001
NODE_ENV=development
JWT_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Frontend -------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Email (SendGrid) -----------------------------------------------------
SENDGRID_API_KEY=
MAIL_FROM=noreply@littlesmartiesnursery.com
ADMIN_ALERT_EMAIL=

# --- Image storage (S3) ---------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=me-central-1
AWS_S3_BUCKET=littlesmarties-images

# --- Deployment (used by infra/scripts/deploy.sh) -------------------------
VPS_HOST=
VPS_USER=
DEPLOY_PATH=/opt/websites/littlesmarties
BACKUP_PATH=/backups/littlesmarties
