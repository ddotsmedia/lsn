{
  "name": "littlesmarties-monorepo",
  "version": "1.0.0",
  "description": "Little Smarties Nursery - Monorepo (Frontend + Backend)",
  "private": true,
  "workspaces": [
    "apps/frontend",
    "apps/backend"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "install-all": "npm install",
    "dev": "npm run dev --workspace=apps/frontend & npm run dev --workspace=apps/backend",
    "build": "npm run build --workspace=apps/frontend && npm run build --workspace=apps/backend",
    "verify-tailwind": "npm list tailwindcss --workspace=apps/frontend"
  },
  "overrides": {
    "tailwindcss": "3.4.19",
    "postcss": "^8.4.31"
  },
  "resolutions": {
    "tailwindcss": "3.4.19"
  },
  "devDependencies": {
    "@types/speakeasy": "2.0.10"
  }
}
