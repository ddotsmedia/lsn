// Prisma Schema for Enterprise Admin Panel
// Little Smarties Nursery Management System

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================================
// USER MANAGEMENT & AUTHENTICATION
// ============================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String
  avatar        String?
  role          UserRole  @default(STAFF)
  status        UserStatus @default(ACTIVE)

  // Two-Factor Authentication
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?

  // Profile
  phone         String?
  department    String?
  bio           String?

  // Audit
  lastLogin     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  announcements Announcement[]
  auditLogs     AuditLog[]

  @@index([email])
  @@index([role])
}

enum UserRole {
  ADMIN
  MANAGER
  TEACHER
  STAFF
  PARENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

// ============================================================================
// ORGANIZATION & SETTINGS
// ============================================================================

model Organization {
  id              String   @id @default(cuid())
  name            String   @unique
  description     String?
  logo            String?
  website         String?
  email           String   @unique
  phone           String?
  address         String?
  city            String?
  state           String?
  zipCode         String?
  country         String?

  // Settings
  academicYear    String   @default("2024-2025")
  operatingHours  String?
  timezone        String   @default("UTC")

  // Finance
  currency        String   @default("AED")
  taxId           String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  ageGroups       AgeGroup[]
  students        Student[]
  announcements   Announcement[]

  @@index([name])
}

// ============================================================================
// ACADEMIC STRUCTURE
// ============================================================================

model AgeGroup {
  id              String   @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name            String   // "Nursery", "Pre-K", "Kindergarten"
  description     String?
  minAge          Int
  maxAge          Int
  capacity        Int

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  classes         Class[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Class {
  id              String   @id @default(cuid())
  ageGroupId      String
  ageGroup        AgeGroup @relation(fields: [ageGroupId], references: [id], onDelete: Cascade)

  name            String   // "A", "B", "C"
  capacity        Int
  currentEnrollment Int @default(0)

  // Curriculum
  curriculum      String?
  dailySchedule   String?  // JSON: {monday: {start: "09:00", end: "12:00"}}

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  students        Student[]
  assignments     ClassAssignment[]
  attendance      Attendance[]
  announcements   ClassAnnouncement[]

  @@unique([ageGroupId, name])
  @@index([ageGroupId])
}

// ============================================================================
// STUDENT MANAGEMENT
// ============================================================================

model Student {
  id                String   @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Personal Information
  firstName         String
  lastName          String
  dateOfBirth       DateTime
  gender            Gender
  nationalId        String?

  // Status
  enrollmentStatus  EnrollmentStatus @default(ACTIVE)
  enrollmentDate    DateTime @default(now())

  // Contact & Location
  currentClassId    String?
  currentClass      Class? @relation(fields: [currentClassId], references: [id])

  // Medical Information
  bloodType         String?
  allergies         String?
  medicalConditions String?
  emergencyContact  String
  emergencyPhone    String

  // Documents
  photos            String[]  // JSON array of photo URLs
  documents         Document[]

  // Fees
  feeStatus         FeeStatus @default(ACTIVE)
  totalFeePaid      Float @default(0)
  totalFeeOwed      Float @default(0)

  // Audit
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  parents           ParentStudent[]
  attendance        Attendance[]
  feeLedger         FeeLedger[]

  @@index([organizationId])
  @@index([currentClassId])
  @@index([enrollmentStatus])
  @@fulltext([firstName, lastName])
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum EnrollmentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  SUSPENDED
  WAITLISTED
}

enum FeeStatus {
  ACTIVE
  PAID
  PENDING
  OVERDUE
  EXEMPTED
}

// ============================================================================
// STAFF & TEACHERS
// ============================================================================

model Staff {
  id              String   @id @default(cuid())

  // Personal
  firstName       String
  lastName        String
  email           String   @unique
  phone           String?

  // Role & Department
  department      String   // "Teaching", "Administration", "Support"
  position        String   // "Teacher", "Principal", "Counselor"
  qualifications  String?  // JSON

  // Employment
  employmentDate  DateTime @default(now())
  status          EmploymentStatus @default(ACTIVE)
  salary          Float?

  // Classes
  classAssignments ClassAssignment[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([email])
  @@index([department])
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  RESIGNED
  RETIRED
}

model ClassAssignment {
  id              String   @id @default(cuid())
  classId         String
  class           Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  staffId         String
  staff           Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  role            TeacherRole  // "Primary", "Assistant", "Substitute"
  assignedDate    DateTime @default(now())
  endDate         DateTime?

  @@unique([classId, staffId])
  @@index([classId])
  @@index([staffId])
}

enum TeacherRole {
  PRIMARY
  ASSISTANT
  SUBSTITUTE
  SPECIALIST
}

// ============================================================================
// PARENT & GUARDIAN
// ============================================================================

model Parent {
  id              String   @id @default(cuid())

  // Personal
  firstName       String
  lastName        String
  email           String   @unique
  phone           String   @unique

  // Relationship
  relationship    String?  // "Mother", "Father", "Guardian"

  // Address
  address         String?
  city            String?
  state           String?
  zipCode         String?
  country         String?

  // Status
  status          ParentStatus @default(ACTIVE)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  students        ParentStudent[]
  communications  ParentCommunication[]

  @@index([email])
  @@fulltext([firstName, lastName])
}

enum ParentStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

model ParentStudent {
  id              String   @id @default(cuid())
  parentId        String
  parent          Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  isPrimary       Boolean  @default(false)

  @@unique([parentId, studentId])
  @@index([parentId])
  @@index([studentId])
}

// ============================================================================
// ATTENDANCE
// ============================================================================

model Attendance {
  id              String   @id @default(cuid())
  classId         String
  class           Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  date            DateTime
  status          AttendanceStatus // PRESENT, ABSENT, LATE, EXCUSED
  notes           String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([classId, studentId, date])
  @@index([classId])
  @@index([studentId])
  @@index([date])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
  HALF_DAY
}

// ============================================================================
// COMMUNICATIONS
// ============================================================================

model Announcement {
  id              String   @id @default(cuid())
  authorId        String
  author          User     @relation(fields: [authorId], references: [id])
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  title           String
  content         String   // Rich text / Markdown
  category        AnnouncementCategory
  audience        Audience // "ALL", "PARENTS", "STAFF", "CLASS"

  // Scheduling
  isScheduled     Boolean  @default(false)
  scheduledDate   DateTime?
  expiryDate      DateTime?

  // Engagement
  readBy          String[] // User IDs
  reactions       String?  // JSON: {emoji: count}

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  classAnnouncements ClassAnnouncement[]

  @@index([organizationId])
  @@index([createdAt])
}

enum AnnouncementCategory {
  GENERAL
  URGENT
  EDUCATIONAL
  EVENT
  REMINDER
}

enum Audience {
  ALL
  PARENTS
  STAFF
  TEACHERS
  CLASS
}

model ClassAnnouncement {
  id              String   @id @default(cuid())
  announcementId  String
  announcement    Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  classId         String
  class           Class    @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([announcementId, classId])
}

model ParentCommunication {
  id              String   @id @default(cuid())
  parentId        String
  parent          Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)

  type            CommunicationType
  subject         String?
  message         String
  sentDate        DateTime @default(now())
  readDate        DateTime?

  // Status
  status          CommunicationStatus @default(SENT)

  @@index([parentId])
  @@index([sentDate])
}

enum CommunicationType {
  EMAIL
  SMS
  NOTIFICATION
  LETTER
}

enum CommunicationStatus {
  DRAFT
  SENT
  DELIVERED
  READ
  FAILED
}

// ============================================================================
// FINANCIAL MANAGEMENT
// ============================================================================

model Fee {
  id              String   @id @default(cuid())
  name            String   // "Tuition", "Lunch", "Activities"
  description     String?
  amount          Float
  frequency       BillingFrequency // "MONTHLY", "TERM", "ANNUAL"
  dueDate         Int      // Day of month (1-31)
  lateFee         Float    @default(0)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  invoices        Invoice[]
}

enum BillingFrequency {
  MONTHLY
  TERM
  ANNUAL
  ONE_TIME
}

model Invoice {
  id              String   @id @default(cuid())
  studentId       String
  student         Student  @relation("StudentInvoices", fields: [studentId], references: [id], onDelete: Cascade)
  feeId           String
  fee             Fee      @relation(fields: [feeId], references: [id])

  invoiceNumber   String   @unique
  amount          Float
  dueDate         DateTime
  status          InvoiceStatus @default(PENDING)

  // Payments
  payments        Payment[]
  amountPaid      Float    @default(0)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([studentId])
  @@index([status])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PENDING
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

model Payment {
  id              String   @id @default(cuid())
  invoiceId       String
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  amount          Float
  method          PaymentMethod
  reference       String?
  status          PaymentStatus @default(COMPLETED)

  createdAt       DateTime @default(now())

  @@index([invoiceId])
  @@index([status])
}

enum PaymentMethod {
  CASH
  CHECK
  BANK_TRANSFER
  CREDIT_CARD
  DEBIT_CARD
  MOBILE_PAYMENT
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model FeeLedger {
  id              String   @id @default(cuid())
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  description     String
  amount          Float
  type            LedgerType // CHARGE, PAYMENT, ADJUSTMENT, WAIVER
  date            DateTime @default(now())

  @@index([studentId])
  @@index([date])
}

enum LedgerType {
  CHARGE
  PAYMENT
  ADJUSTMENT
  WAIVER
  CREDIT
}

// ============================================================================
// CONTENT MANAGEMENT
// ============================================================================

model Page {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  description     String?
  content         String?  // Rich text

  isPublished     Boolean  @default(false)
  publishedAt     DateTime?

  seo             Seo?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isPublished])
}

model Seo {
  id              String   @id @default(cuid())
  pageId          String   @unique
  page            Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  metaTitle       String?
  metaDescription String?
  keywords        String[]
  ogImage         String?
  ogTitle         String?
  ogDescription   String?

  @@index([pageId])
}

model Gallery {
  id              String   @id @default(cuid())
  name            String
  description     String?
  isPublic        Boolean  @default(true)

  photos          GalleryPhoto[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model GalleryPhoto {
  id              String   @id @default(cuid())
  galleryId       String
  gallery         Gallery  @relation(fields: [galleryId], references: [id], onDelete: Cascade)

  url             String
  caption         String?
  order           Int      @default(0)

  @@index([galleryId])
}

model Document {
  id              String   @id @default(cuid())
  studentId       String?
  student         Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  name            String
  type            String   // "PDF", "IMAGE", etc
  url             String
  category        String?  // "Medical", "ID", "Enrollment", etc

  createdAt       DateTime @default(now())

  @@index([studentId])
}

// ============================================================================
// AUDIT & LOGGING
// ============================================================================

model AuditLog {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])

  action          String   // CREATE, UPDATE, DELETE
  entity          String   // Student, Class, Payment
  entityId        String
  changes         String?  // JSON: {field: {old, new}}

  ipAddress       String?
  userAgent       String?

  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ============================================================================
// RELATIONSHIPS NEEDED
// ============================================================================
// Student needs: parents, classes, attendance, fees
// Parent needs: students, communications
// Staff needs: class assignments, announcements
// Class needs: students, staff, attendance
// Announcements need: recipients, read status
// Invoices need: payments, payment methods
